// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  createdAT      DateTime         @default(now())
  updatedAT      DateTime         @updatedAt
  blackListToken BlackListToken[]
  products       Products[]
  Buys           Buys[]
}

model Products {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  price         Decimal        @default(0)
  stock         Decimal        @default(0)
  createdAT     DateTime       @default(now())
  updatedAT     DateTime       @updatedAt
  User          User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId        Int?
  unit          String         @default("unit")
  iva           Boolean        @default(false)
  history_price HistoryPrice[]
  Buys          Buys[]
  Sales         Sales[]
  salesId       Int?
}

model HistoryPrice {
  id          Int       @id @default(autoincrement())
  price       Decimal
  products    Products? @relation(fields: [products_id], references: [id])
  products_id Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model BlackListToken {
  id     Int    @id @default(autoincrement())
  token  String @unique
  user   User   @relation(fields: [userId], references: [id])
  userId Int
}

model Buys {
  id            Int            @id @default(autoincrement())
  products      Products[]
  list_products ListProducts[]
  total_price   Decimal        @default(0)
  createdAT     DateTime       @default(now())
  updatedAT     DateTime       @updatedAt
  User          User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId        Int?
}

model ListProducts {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @default(0)
  stock     Decimal  @default(0)
  unit      String   @default("unit")
  createdAT DateTime @default(now())
  updatedAT DateTime @updatedAt
  Buys      Buys?    @relation(fields: [buysId], references: [id])
  buysId    Int?
  Sales     Sales?   @relation(fields: [salesId], references: [id])
  salesId   Int?
}

model Clients {
  id         Int      @id @default(autoincrement())
  name       String
  last_name  String
  ci         Int      @unique @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sales      Sales[]
}

model Sales {
  id             Int             @id @default(autoincrement())
  list_products  ListProducts[]
  products       Products[]
  total_price    Decimal
  payments       Payments[]
  change_manager ChangeManager[]
  debt           Decimal         @default(0)
  status         String
  id_client      Int
  client         Clients         @relation(fields: [id_client], references: [id], onDelete: Restrict)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
}

model Payments {
  id             Int      @id @default(autoincrement())
  payment_method Method @default(efectivoBs)
  payment_amount Decimal
  operation      Int      @default(0)
  sales_id       Int?
  sales          Sales?   @relation(fields: [sales_id], references: [id])
  created_at     DateTime @default(now())
}

model ChangeManager {
  id            Int      @id @default(autoincrement())
  change_method Method @default(efectivoBs)
  change_amount Decimal
  operation     Int      @default(0)
  sale_id       Int
  sale          Sales?   @relation(fields: [sale_id], references: [id])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

enum Method {
  efectivoBs
  divisa
  transferencia
  biopago
}

